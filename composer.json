{
    "name": "horde/injector",
    "description": "Dependency injection container library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Injector",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "psr-11",
        "psr-container",
        "dic",
        "ioc",
        "service-container",
        "dependency-injection",
        "container",
        "autowiring"
    ],
    "time": "2026-04-16",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "psr/container": "^2",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_Injector": "lib/"
        },
        "psr-4": {
            "Horde\\Injector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Injector\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "provide": {
        "psr/container-implementation": "2.0.1"
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}