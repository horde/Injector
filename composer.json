{
    "name": "horde/injector",
    "description": "Dependency injection container library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Injector",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "time": "2025-05-05",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "psr/container": "^2",
        "horde/exception": "^3"
    },
    "require-dev": {
        "horde/test": "^3",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2"
    },
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_Injector": "lib/"
        },
        "psr-4": {
            "Horde\\Injector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Injector\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "provide": {
        "psr/container-implementation": "2.0.1"
    }
}